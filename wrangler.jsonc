{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "party",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // One Durable Object per room: it runs the game's rules and sends each phone only what it may see.
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "RoomObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject"] }],
  "routes": [{ "pattern": "party.graaf.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
}
